# 复制成 .env 后填写。真实值不入库。
# 数据库：本机 PostgreSQL 18（scoop 安装，服务形式运行）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/starmap

# 模型端点。本仓库默认只走 chat；两个端点都没有 embedding 模型（实测）。
LLM_BASE_URL=https://d1api.xin/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# 关掉外发遥测（票 01 验收项）
MASTRA_TELEMETRY_DISABLED=1

# 前端
VITE_API_BASE_URL=http://127.0.0.1:3001

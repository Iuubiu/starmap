{
  "name": "@mastra/nestjs",
  "version": "0.2.37",
  "description": "Mastra NestJS adapter for the server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "hono": "^4.13.7",
    "@mastra/server": "1.78.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.115",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.2",
    "cors": "^2.8.5",
    "eslint": "^10.7.0",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.1.1",
    "tsdown": "0.22.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^3.25.0",
    "@internal/lint": "0.0.144",
    "@mastra/server-adapters-test-suite": "0.1.2",
    "@mastra/evals": "1.10.7",
    "@internal/types-builder": "0.0.119",
    "@mastra/libsql": "1.26.2",
    "@mastra/memory": "1.38.0",
    "@mastra/observability": "1.20.1",
    "@internal/storage-test-utils": "0.0.140",
    "@mastra/core": "1.78.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.58.0-0 <2.0.0-0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/nestjs"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  }
}
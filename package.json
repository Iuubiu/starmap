{
  "name": "starmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @starmap/api dev",
    "dev:web": "pnpm --filter @starmap/web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @starmap/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @starmap/web exec playwright test smoke.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "contract:gen": "pnpm --filter @starmap/api-contract build && pnpm --filter @starmap/api-contract gen && pnpm --filter @starmap/api contract:emit",
    "contract:check": "node scripts/contract-check.mjs",
    "db:migrate": "pnpm --filter @starmap/api db:migrate",
    "db:rollback": "pnpm --filter @starmap/api db:rollback",
    "db:seed": "pnpm --filter @starmap/api db:seed",
    "verify": "node scripts/verify.mjs",
    "verify:py": "python -m pytest tools/ingest/ -q"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "24.10.1",
    "dependency-cruiser": "18.7.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}

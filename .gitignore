node_modules/
dist/
build/
coverage/
*.log
.env
.env.local
data/
.DS_Store
*.tsbuildinfo
.vitest/
test-results/
playwright-report/
.scratch/pgcheck/
.scratch/probe/

# Python
__pycache__/
*.pyc

# AgentTeams 运行时状态（含成员会话与邮箱，不进版本库）
.agent-teams/

# 各泳道的一次性探针与产物
apps/api/.probe/
apps/web/.scratch/

# captain 的临时核查脚本与查询（一次性，读完就废）。已经 tracked 的
# `.scratch/starmap-core/`、`spec-decisions.md` 等不受影响 —— git 不会因为
# 后加的 ignore 规则而停止跟踪已入库文件。
.scratch/probes/
.scratch/*.sql
.scratch/*.mjs
.scratch/*.js
.scratch/*.py
.scratch/*.json
.scratch/*.jsonl
.scratch/*.txt
.scratch/*.out
.scratch/pw-*/

# 各泳道的临时取证目录（截图、OCR 批次产物、日志）。这类东西写完就废，
# 但单个目录 30 MB 起步，进一次库就再也删不掉了 —— 必须整目录忽略。
.scratch/t17/
.scratch/probe2/
.scratch/ocrbench/

# DSH 文件工具（ops_edit_file / ops_write_file）的临时锁。写完就删，被中断时才会留下
# 0 字节残留。它们不是任何人的代码，不该出现在 git status 里。
.dsh-ops-update-*.lock


# 教材与论文原件（134 个 PDF / 1.14 GiB）。已在历史中，需 filter-repo 才能移除，
# 见 README「已知问题」。新增大文件一律走这里，不要再 git add 资源库/。
# 探针下载/缓存产物（视频、模型权重、浏览器 profile、临时转换文件）
.scratch/*.m4s
.scratch/a0.m4s
.scratch/models/
.scratch/chrome-profile/
.scratch/video-probe/
.scratch/vidtest/
.scratch/bgutil/
.scratch/toc_text/
tools/eval/.scratch/

# 探针跑完落下的 playwright 运行残留（不要进库）
apps/.scratch/
apps/web/.scratch/

# 语义检索向量库（t82）：本机生成、体积大，不进仓库
content/embeddings/

# 外部 clone 进来的仓库，不入版本库
.scratch/skill-dl/

# 内容管线的"修复前快照"副本：tools/ingest 的 --dry-run 重放用，体积大（~326MB），可随时用 git archive 重建
.scratch/qa/t94-pre/
# 探针/救援临时产物
.scratch/salvage/
.scratch/*.bak-*

# 演示版与录制产物：只在本地，不入库（用户要求）
.scratch/demo/
.scratch/qa/

# ── 2026-10-26 GitHub 同步前的剥离边界 ──
# git filter-repo 已把这些从全部历史移除（5.32 GiB → 320 MiB）；这里防回流。
# 依据 README 的分发政策：教材 PDF / 论文 / 课程视频 / 切片文本是版权材料，不入库。
资源库/
content/videos/
content/*/chunks.jsonl
# 大体积实验产物与本机备份（dump 里是内容库整库导出）
.scratch/t82/
.scratch/nuke/
.scratch/video-work/
.scratch/**/*.dump
.scratch/**/chunks.jsonl

node_modules/
dist/
build/
coverage/
*.log
.env
.env.local
data/
.DS_Store
*.tsbuildinfo
.vitest/
test-results/
playwright-report/
.scratch/pgcheck/
.scratch/probe/

# Python
__pycache__/
*.pyc

# AgentTeams 运行时状态（含成员会话与邮箱，不进版本库）
.agent-teams/

# 各泳道的一次性探针与产物
apps/api/.probe/
apps/web/.scratch/

# captain 的临时核查脚本与查询（一次性，读完就废）。已经 tracked 的
# `docs/spec/`、`spec-decisions.md` 等不受影响 —— git 不会因为
# 后加的 ignore 规则而停止跟踪已入库文件。
.scratch/probes/
.scratch/*.sql
.scratch/*.mjs
.scratch/*.js
.scratch/*.py
.scratch/*.json
.scratch/*.jsonl
.scratch/*.txt
.scratch/*.out
.scratch/pw-*/

# 各泳道的临时取证目录（截图、OCR 批次产物、日志）。这类东西写完就废，
# 但单个目录 30 MB 起步，进一次库就再也删不掉了 —— 必须整目录忽略。
.scratch/t17/
.scratch/probe2/
.scratch/ocrbench/

# DSH 文件工具（ops_edit_file / ops_write_file）的临时锁。写完就删，被中断时才会留下
# 0 字节残留。它们不是任何人的代码，不该出现在 git status 里。
.dsh-ops-update-*.lock


# 教材与论文原件（134 个 PDF / 1.14 GiB）。已在历史中，需 filter-repo 才能移除，
# 见 README「已知问题」。新增大文件一律走这里，不要再 git add 资源库/。
# 探针下载/缓存产物（视频、模型权重、浏览器 profile、临时转换文件）
.scratch/*.m4s
.scratch/a0.m4s
.scratch/models/
.scratch/chrome-profile/
.scratch/video-probe/
.scratch/vidtest/
.scratch/bgutil/
.scratch/toc_text/
tools/eval/.scratch/

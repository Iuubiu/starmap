{
  "name": "@starmap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "contract:emit": "node ./scripts/emit-openapi.mjs",
    "db:migrate": "tsx ./scripts/migrate.ts up",
    "db:rollback": "tsx ./scripts/migrate.ts down",
    "db:seed": "tsx ./scripts/migrate.ts seed"
  },
  "dependencies": {
    "@mastra/core": "1.78.0",
    "@mastra/nestjs": "0.2.37",
    "@mastra/pg": "1.31.2",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@starmap/api-contract": "workspace:*",
    "@starmap/engine": "workspace:*",
    "@starmap/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "openapi-response-validator": "12.1.0",
    "supertest": "7.1.4",
    "tsx": "^4.23.15",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
